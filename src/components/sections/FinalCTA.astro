---
import CTAButton from "../CTAButton.astro";
---

<section class="bg-ink py-16 text-paper md:py-24">
  <div class="fade-in-section mx-auto max-w-[1100px] px-4 text-center sm:px-6">
    <h2
      class="mx-auto max-w-2xl font-serif text-3xl font-semibold leading-tight tracking-tight sm:text-4xl"
    >
      Not sure where you are? Start with a Deal Call.
    </h2>
    <div class="mt-8">
      <CTAButton offering="dealCall" label="Book a Deal Call" />
    </div>
    <p class="mt-5 text-sm text-paper-soft">
      $150. 45 minutes. Bring a real listing.
    </p>
  </div>
</section>
