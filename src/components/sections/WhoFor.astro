---
const forYou = [
  "First-time buyers, or second-timers who want to do it right.",
  "SBA-financed deals, roughly $500K to $5M.",
  "You'll search listings yourself and sign an NDA.",
  "You want an advisor, not a done-for-you service.",
];

const notForYou = [
  "You want deals found for you or brought to you off-market. That costs many thousands of dollars elsewhere, and this isn't it.",
  "You're a private equity or search fund buyer with a deal team.",
  "You're not ready to look at a P&L.",
  "You want legal, tax, or investment advice.",
];
---

<section class="border-t border-line py-16 md:py-24">
  <div
    class="fade-in-section mx-auto grid max-w-[1100px] gap-12 px-4 sm:px-6 md:grid-cols-2 md:gap-16"
  >
    <div>
      <h2 class="font-serif text-2xl font-semibold tracking-tight">
        This is for you if
      </h2>
      <ul class="mt-6 flex flex-col gap-4 text-ink-soft">
        {forYou.map((item) => <li class="leading-relaxed">{item}</li>)}
      </ul>
    </div>
    <div>
      <h2 class="font-serif text-2xl font-semibold tracking-tight">
        This is not for you if
      </h2>
      <ul class="mt-6 flex flex-col gap-4 text-ink-soft">
        {notForYou.map((item) => <li class="leading-relaxed">{item}</li>)}
      </ul>
    </div>
  </div>
</section>
