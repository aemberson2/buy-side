---
import { site } from "../../config/site";
---

<section id="faq" class="border-t border-line py-16 md:py-24">
  <div class="fade-in-section mx-auto max-w-[1100px] px-4 sm:px-6">
    <h2
      class="font-serif text-3xl font-semibold leading-tight tracking-tight sm:text-4xl"
    >
      Questions people ask
    </h2>

    <div class="mt-10 max-w-3xl divide-y divide-line border-y border-line">
      {
        site.faq.map((item) => (
          <details class="faq-item group py-2">
            <summary class="flex items-center justify-between gap-4 py-3 text-left font-medium text-ink">
              <span>{item.question}</span>
              <span
                class="faq-marker shrink-0 text-xl leading-none text-accent"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="max-w-prose pb-4 leading-relaxed text-ink-soft">
              {item.answer}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
