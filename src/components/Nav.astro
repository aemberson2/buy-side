---
import { site } from "../config/site";
import CTAButton from "./CTAButton.astro";

const links = [
  { href: "#help", label: "How I help" },
  { href: "#pricing", label: "Pricing" },
  { href: "#compare", label: "Compare" },
  { href: "#about", label: "About" },
  { href: "#faq", label: "FAQ" },
];
---

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-200"
>
  <nav
    aria-label="Main"
    class="mx-auto flex h-16 max-w-[1100px] items-center justify-between px-4 sm:px-6"
  >
    <a
      href="#top"
      class="font-serif text-lg font-semibold tracking-tight text-ink"
    >
      <span class="placeholder-value">{site.name}</span>
    </a>

    <div class="hidden items-center gap-7 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-ink-soft transition-colors hover:text-ink"
          >
            {link.label}
          </a>
        ))
      }
      <CTAButton
        offering="dealCall"
        label="Book a Deal Call"
        class="!px-4 !py-2 text-sm"
      />
    </div>

    <button
      id="nav-toggle"
      type="button"
      class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <span class="block h-0.5 w-5 bg-ink"></span>
      <span class="block h-0.5 w-5 bg-ink"></span>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="hidden border-t border-line bg-paper px-4 pb-6 pt-2 md:hidden"
  >
    <div class="flex flex-col gap-1">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="mobile-menu-link rounded-[6px] px-2 py-3 text-base font-medium text-ink"
          >
            {link.label}
          </a>
        ))
      }
      <div class="mt-3 px-2">
        <CTAButton offering="dealCall" label="Book a Deal Call" class="w-full text-center" />
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-nav");
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");

  // Slightly opaque background once the page scrolls.
  const onScroll = () => {
    if (!header) return;
    header.classList.toggle("nav-scrolled", window.scrollY > 8);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const open = menu.classList.toggle("hidden") === false;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    });
    menu.querySelectorAll(".mobile-menu-link, a").forEach((link) =>
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
        toggle.setAttribute("aria-expanded", "false");
      })
    );
  }
</script>

<style>
  #site-nav {
    background: transparent;
  }
  #site-nav.nav-scrolled {
    background: rgba(250, 248, 245, 0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--color-line);
  }
  /* Mobile menu always needs a solid background when open. */
  #site-nav:has(#mobile-menu:not(.hidden)) {
    background: var(--color-paper);
  }
</style>
